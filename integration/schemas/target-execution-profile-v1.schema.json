{
  "$defs": {
    "Baseline": {
      "additionalProperties": false,
      "description": "Operating system and ROS baseline of a host or required by an artifact.",
      "properties": {
        "jetpack": {
          "minLength": 1,
          "title": "Jetpack",
          "type": "string"
        },
        "os": {
          "minLength": 1,
          "title": "Os",
          "type": "string"
        },
        "ros_distro": {
          "minLength": 1,
          "title": "Ros Distro",
          "type": "string"
        }
      },
      "required": [
        "os",
        "ros_distro"
      ],
      "title": "Baseline",
      "type": "object"
    },
    "Endpoint": {
      "additionalProperties": false,
      "description": "One ROS interface keyed by its exact name in a role map.",
      "properties": {
        "durability": {
          "enum": [
            "volatile",
            "transient_local"
          ],
          "title": "Durability",
          "type": "string"
        },
        "reliability": {
          "enum": [
            "reliable",
            "best_effort"
          ],
          "title": "Reliability",
          "type": "string"
        },
        "type": {
          "minLength": 1,
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "Endpoint",
      "type": "object"
    },
    "Host": {
      "additionalProperties": false,
      "description": "One execution host; a declared device list is complete.",
      "properties": {
        "architecture": {
          "enum": [
            "arm64",
            "amd64"
          ],
          "title": "Architecture",
          "type": "string"
        },
        "baseline": {
          "$ref": "#/$defs/Baseline"
        },
        "devices": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Devices",
          "type": "array"
        },
        "role": {
          "enum": [
            "native",
            "controller",
            "edge"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "architecture"
      ],
      "title": "Host",
      "type": "object"
    },
    "MobilityTarget": {
      "additionalProperties": false,
      "description": "The mobility target described by a reusable profile.",
      "properties": {
        "kind": {
          "enum": [
            "sdv",
            "sdr"
          ],
          "title": "Kind",
          "type": "string"
        },
        "target_id": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "target_id",
        "kind"
      ],
      "title": "MobilityTarget",
      "type": "object"
    },
    "RoleMap": {
      "additionalProperties": {
        "$ref": "#/$defs/Endpoint"
      },
      "propertyNames": {
        "minLength": 1
      },
      "type": "object"
    },
    "RoleMaps": {
      "additionalProperties": false,
      "description": "The six ROS role maps; an omitted map is unknown.",
      "properties": {
        "action_clients": {
          "$ref": "#/$defs/RoleMap",
          "title": "Action Clients"
        },
        "action_servers": {
          "$ref": "#/$defs/RoleMap",
          "title": "Action Servers"
        },
        "publishes": {
          "$ref": "#/$defs/RoleMap",
          "title": "Publishes"
        },
        "service_clients": {
          "$ref": "#/$defs/RoleMap",
          "title": "Service Clients"
        },
        "service_servers": {
          "$ref": "#/$defs/RoleMap",
          "title": "Service Servers"
        },
        "subscribes": {
          "$ref": "#/$defs/RoleMap",
          "title": "Subscribes"
        }
      },
      "title": "RoleMaps",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A reusable description of one candidate execution environment.",
  "properties": {
    "connections": {
      "items": {
        "items": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "maxItems": 2,
        "minItems": 2,
        "type": "array"
      },
      "title": "Connections",
      "type": "array"
    },
    "hosts": {
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$": {
          "$ref": "#/$defs/Host"
        }
      },
      "propertyNames": {
        "maxLength": 63
      },
      "title": "Hosts",
      "type": "object"
    },
    "orchestrator_provides": {
      "$ref": "#/$defs/RoleMaps",
      "title": "Orchestrator Provides"
    },
    "profile_id": {
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Profile Id",
      "type": "string"
    },
    "schema_version": {
      "const": "sdi.target-execution-profile/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/MobilityTarget"
    }
  },
  "required": [
    "schema_version",
    "profile_id",
    "target",
    "hosts"
  ],
  "title": "TargetExecutionProfile",
  "type": "object"
}
