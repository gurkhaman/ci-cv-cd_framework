{
  "$defs": {
    "DiscoverySettings": {
      "additionalProperties": false,
      "description": "Discovery settings every generator shares; no embeddings is lexical only.",
      "properties": {
        "embeddings": {
          "$ref": "#/$defs/EmbeddingsConfig",
          "title": "Embeddings"
        }
      },
      "title": "DiscoverySettings",
      "type": "object"
    },
    "EmbeddingsConfig": {
      "additionalProperties": false,
      "description": "The endpoint that embeds descriptions and queries for dense discovery.",
      "properties": {
        "api_key_env": {
          "minLength": 1,
          "title": "Api Key Env",
          "type": "string"
        },
        "base_url": {
          "minLength": 1,
          "title": "Base Url",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "on_unavailable": {
          "default": "fail",
          "enum": [
            "fail",
            "lexical"
          ],
          "title": "On Unavailable",
          "type": "string"
        }
      },
      "required": [
        "model",
        "base_url",
        "api_key_env"
      ],
      "title": "EmbeddingsConfig",
      "type": "object"
    },
    "GeneratorConfig": {
      "additionalProperties": false,
      "description": "One generator's model, limits, context budget and endpoint.",
      "properties": {
        "api_key_env": {
          "minLength": 1,
          "title": "Api Key Env",
          "type": "string"
        },
        "base_url": {
          "minLength": 1,
          "title": "Base Url",
          "type": "string"
        },
        "max_context_bytes": {
          "exclusiveMinimum": 0,
          "title": "Max Context Bytes",
          "type": "integer"
        },
        "max_output_tokens": {
          "exclusiveMinimum": 0,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "reasoning_effort": {
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh"
          ],
          "title": "Reasoning Effort",
          "type": "string"
        },
        "timeout_seconds": {
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "required": [
        "model",
        "reasoning_effort",
        "max_output_tokens",
        "timeout_seconds",
        "max_context_bytes",
        "base_url",
        "api_key_env"
      ],
      "title": "GeneratorConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The one generator a run uses, with the shared discovery settings.\n\nThe config's path and digest tie these settings to the committed bytes they\nwere resolved from.",
  "properties": {
    "config_path": {
      "minLength": 1,
      "title": "Config Path",
      "type": "string"
    },
    "config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Config Sha256",
      "type": "string"
    },
    "discovery": {
      "$ref": "#/$defs/DiscoverySettings"
    },
    "generator": {
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Generator",
      "type": "string"
    },
    "generator_config": {
      "$ref": "#/$defs/GeneratorConfig"
    },
    "schema_version": {
      "const": "sdi.composition-settings/v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "config_path",
    "config_sha256",
    "generator",
    "generator_config",
    "discovery"
  ],
  "title": "CompositionSettings",
  "type": "object"
}
