{
  "additionalProperties": false,
  "description": "Front matter of a Markdown Mobility Requirements Specification.",
  "properties": {
    "document_version": {
      "exclusiveMinimum": 0,
      "title": "Document Version",
      "type": "integer"
    },
    "requirement_ids": {
      "items": {
        "maxLength": 63,
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Requirement Ids",
      "type": "array"
    },
    "schema_version": {
      "const": "sdi.mobility-requirements-specification/v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "document_version",
    "requirement_ids"
  ],
  "title": "MobilityRequirementsSpecification",
  "type": "object"
}
