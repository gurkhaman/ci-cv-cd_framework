{
  "$defs": {
    "EvidenceDescription": {
      "additionalProperties": false,
      "description": "One service description supplied to generation and assessment.",
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "EvidenceDescription",
      "type": "object"
    },
    "GenerationRecord": {
      "additionalProperties": false,
      "description": "The settings, exact request and response summary of one generation.",
      "properties": {
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "max_output_tokens": {
          "exclusiveMinimum": 0,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "max_retries": {
          "minimum": 0,
          "title": "Max Retries",
          "type": "integer"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "generated",
            "exhausted"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "reasoning_effort": {
          "minLength": 1,
          "title": "Reasoning Effort",
          "type": "string"
        },
        "request": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Request",
          "type": "object"
        },
        "response": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Response",
          "type": "object"
        },
        "timeout_seconds": {
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "required": [
        "config_sha256",
        "model",
        "reasoning_effort",
        "max_output_tokens",
        "timeout_seconds",
        "max_retries",
        "outcome",
        "request",
        "response"
      ],
      "title": "GenerationRecord",
      "type": "object"
    },
    "JsonValue": {},
    "SourceInputDigest": {
      "additionalProperties": false,
      "description": "Stable exact-byte input correlation embedded in Domain outputs.",
      "properties": {
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "slot": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
          "title": "Slot",
          "type": "string"
        }
      },
      "required": [
        "slot",
        "sha256"
      ],
      "title": "SourceInputDigest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "How the composition Stage reached its outcome; never a Domain input.",
  "properties": {
    "assessment": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Assessment",
      "type": "object"
    },
    "combination_id": {
      "pattern": "^C-[0-9]{2}$",
      "title": "Combination Id",
      "type": "string"
    },
    "descriptions": {
      "items": {
        "$ref": "#/$defs/EvidenceDescription"
      },
      "minItems": 1,
      "title": "Descriptions",
      "type": "array"
    },
    "evidence_basis": {
      "const": "implemented",
      "title": "Evidence Basis",
      "type": "string"
    },
    "generation": {
      "$ref": "#/$defs/GenerationRecord"
    },
    "profile_id": {
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Profile Id",
      "type": "string"
    },
    "scenario_id": {
      "pattern": "^S-[0-9]{2}$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "sdi.composition-evidence/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_inputs": {
      "items": {
        "$ref": "#/$defs/SourceInputDigest"
      },
      "maxItems": 5,
      "minItems": 5,
      "title": "Source Inputs",
      "type": "array"
    },
    "testcase_id": {
      "pattern": "^TC-[0-9]{2}$",
      "title": "Testcase Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "evidence_basis",
    "scenario_id",
    "testcase_id",
    "combination_id",
    "profile_id",
    "source_inputs",
    "descriptions",
    "generation"
  ],
  "title": "CompositionEvidence",
  "type": "object"
}
