{
  "$defs": {
    "CountingTopic": {
      "additionalProperties": false,
      "description": "Messages counted on one of a service's counting outputs.",
      "properties": {
        "messages": {
          "minimum": 0,
          "title": "Messages",
          "type": "integer"
        },
        "topic": {
          "minLength": 1,
          "title": "Topic",
          "type": "string"
        }
      },
      "required": [
        "topic",
        "messages"
      ],
      "title": "CountingTopic",
      "type": "object"
    },
    "Mission": {
      "additionalProperties": false,
      "description": "The scenario's setup and one step per requirement, in requirement order.",
      "properties": {
        "setup": {
          "enum": [
            "passed",
            "timed_out"
          ],
          "title": "Setup",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/MissionStep"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "setup",
        "steps"
      ],
      "title": "Mission",
      "type": "object"
    },
    "MissionStep": {
      "additionalProperties": false,
      "description": "One requirement's mission step; waited_on names the topic or action.",
      "properties": {
        "requirement_id": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Requirement Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "timed_out",
            "scripted",
            "not_reached"
          ],
          "title": "Status",
          "type": "string"
        },
        "waited_on": {
          "minLength": 1,
          "title": "Waited On",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "status"
      ],
      "title": "MissionStep",
      "type": "object"
    },
    "NonParticipatingService": {
      "additionalProperties": false,
      "description": "A service that failed to start, exited, or sent no counted message.",
      "properties": {
        "counting_topics": {
          "items": {
            "$ref": "#/$defs/CountingTopic"
          },
          "title": "Counting Topics",
          "type": "array"
        },
        "detail": {
          "pattern": "^[\\x20\\x21\\x23-\\x5b\\x5d-\\x7e]{1,256}$",
          "title": "Detail",
          "type": "string"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "image_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Image Digest",
          "type": "string"
        },
        "participation": {
          "const": "did_not_participate",
          "title": "Participation",
          "type": "string"
        },
        "reason": {
          "enum": [
            "container-exited",
            "failed-to-start",
            "no-message"
          ],
          "title": "Reason",
          "type": "string"
        },
        "service_id": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Service Id",
          "type": "string"
        }
      },
      "required": [
        "service_id",
        "participation",
        "reason"
      ],
      "title": "NonParticipatingService",
      "type": "object"
    },
    "ParticipatingService": {
      "additionalProperties": false,
      "description": "A service still running when the orchestrator exited.\n\nUnless its participation is loosened, it also sent a message on a\ncounting output.",
      "properties": {
        "counting_topics": {
          "items": {
            "$ref": "#/$defs/CountingTopic"
          },
          "title": "Counting Topics",
          "type": "array"
        },
        "image_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Image Digest",
          "type": "string"
        },
        "participation": {
          "enum": [
            "participated",
            "participated_loosened"
          ],
          "title": "Participation",
          "type": "string"
        },
        "service_id": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Service Id",
          "type": "string"
        }
      },
      "required": [
        "service_id",
        "participation",
        "image_digest",
        "counting_topics"
      ],
      "title": "ParticipatingService",
      "type": "object"
    },
    "SourceInputDigest": {
      "additionalProperties": false,
      "description": "Stable exact-byte input correlation embedded in Domain outputs.",
      "properties": {
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "slot": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
          "title": "Slot",
          "type": "string"
        }
      },
      "required": [
        "slot",
        "sha256"
      ],
      "title": "SourceInputDigest",
      "type": "object"
    },
    "UnevaluatedService": {
      "additionalProperties": false,
      "description": "A service whose participation a pipeline gap kept from being judged.",
      "properties": {
        "counting_topics": {
          "items": {
            "$ref": "#/$defs/CountingTopic"
          },
          "title": "Counting Topics",
          "type": "array"
        },
        "detail": {
          "pattern": "^[\\x20\\x21\\x23-\\x5b\\x5d-\\x7e]{1,256}$",
          "title": "Detail",
          "type": "string"
        },
        "image_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Image Digest",
          "type": "string"
        },
        "participation": {
          "const": "not_evaluated",
          "title": "Participation",
          "type": "string"
        },
        "reason": {
          "enum": [
            "image-unavailable",
            "no-amd64",
            "needs-gpu-or-device",
            "unsupported-command",
            "no-counting-output",
            "unloadable-type",
            "blocked"
          ],
          "title": "Reason",
          "type": "string"
        },
        "service_id": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Service Id",
          "type": "string"
        }
      },
      "required": [
        "service_id",
        "participation",
        "reason"
      ],
      "title": "UnevaluatedService",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "How CV reached its verdict on one composition in the Validation scenario.\n\nThe verdict is the attempt's domain outcome: not evaluated when a pipeline\ngap kept any service from being judged, succeeded when every service\nparticipated and the mission completed, and failed otherwise.",
  "properties": {
    "blueprint_id": {
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Blueprint Id",
      "type": "string"
    },
    "combination_id": {
      "pattern": "^C-[0-9]{2}$",
      "title": "Combination Id",
      "type": "string"
    },
    "deployment_schema_id": {
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Deployment Schema Id",
      "type": "string"
    },
    "domain_outcome": {
      "enum": [
        "succeeded",
        "failed",
        "not_evaluated"
      ],
      "title": "Domain Outcome",
      "type": "string"
    },
    "evidence_basis": {
      "const": "implemented",
      "title": "Evidence Basis",
      "type": "string"
    },
    "image_build_result_id": {
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Image Build Result Id",
      "type": "string"
    },
    "kpi_evaluation": {
      "const": "not_evaluated",
      "title": "Kpi Evaluation",
      "type": "string"
    },
    "mission": {
      "$ref": "#/$defs/Mission"
    },
    "negative_cases": {
      "const": "not_evaluated",
      "title": "Negative Cases",
      "type": "string"
    },
    "platform": {
      "const": "linux/amd64",
      "title": "Platform",
      "type": "string"
    },
    "profile_id": {
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Profile Id",
      "type": "string"
    },
    "scenario_id": {
      "pattern": "^S-[0-9]{2}$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "sdi.validation-evidence/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "services": {
      "items": {
        "discriminator": {
          "mapping": {
            "did_not_participate": "#/$defs/NonParticipatingService",
            "not_evaluated": "#/$defs/UnevaluatedService",
            "participated": "#/$defs/ParticipatingService",
            "participated_loosened": "#/$defs/ParticipatingService"
          },
          "propertyName": "participation"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/ParticipatingService"
          },
          {
            "$ref": "#/$defs/NonParticipatingService"
          },
          {
            "$ref": "#/$defs/UnevaluatedService"
          }
        ]
      },
      "minItems": 1,
      "title": "Services",
      "type": "array"
    },
    "source_inputs": {
      "items": {
        "$ref": "#/$defs/SourceInputDigest"
      },
      "maxItems": 6,
      "minItems": 6,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/SourceInputDigest"
            }
          ],
          "properties": {
            "slot": {
              "const": "requirements_specification"
            }
          }
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/SourceInputDigest"
            }
          ],
          "properties": {
            "slot": {
              "const": "target_profile"
            }
          }
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/SourceInputDigest"
            }
          ],
          "properties": {
            "slot": {
              "const": "service_repository"
            }
          }
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/SourceInputDigest"
            }
          ],
          "properties": {
            "slot": {
              "const": "composition_blueprint"
            }
          }
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/SourceInputDigest"
            }
          ],
          "properties": {
            "slot": {
              "const": "deployment_schema"
            }
          }
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/SourceInputDigest"
            }
          ],
          "properties": {
            "slot": {
              "const": "image_build_result"
            }
          }
        }
      ],
      "title": "Source Inputs",
      "type": "array"
    },
    "testcase_id": {
      "pattern": "^TC-[0-9]{2}$",
      "title": "Testcase Id",
      "type": "string"
    },
    "validation_evidence_id": {
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Validation Evidence Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "evidence_basis",
    "validation_evidence_id",
    "blueprint_id",
    "deployment_schema_id",
    "image_build_result_id",
    "scenario_id",
    "testcase_id",
    "combination_id",
    "profile_id",
    "source_inputs",
    "domain_outcome",
    "kpi_evaluation",
    "negative_cases",
    "platform",
    "services"
  ],
  "title": "ValidationEvidence",
  "type": "object"
}
