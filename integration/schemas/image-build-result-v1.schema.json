{
  "$defs": {
    "BuiltImageRecord": {
      "additionalProperties": false,
      "description": "A placement whose image was pushed to the pipeline registry.\n\nThe digest is an index for several architectures and a plain manifest for\none.",
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "platforms": {
          "items": {
            "$ref": "#/$defs/PlatformImage"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Platforms",
          "type": "array"
        },
        "repository": {
          "maxLength": 67,
          "pattern": "^sdi/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Repository",
          "type": "string"
        },
        "service_id": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Service Id",
          "type": "string"
        },
        "status": {
          "const": "built",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "service_id",
        "status",
        "repository",
        "digest",
        "platforms"
      ],
      "title": "BuiltImageRecord",
      "type": "object"
    },
    "FailedImageRecord": {
      "additionalProperties": false,
      "description": "A placement that has no image, with one reason from a closed set.",
      "properties": {
        "detail": {
          "pattern": "^[\\x20\\x21\\x23-\\x5b\\x5d-\\x7e]{1,256}$",
          "title": "Detail",
          "type": "string"
        },
        "reason": {
          "enum": [
            "unresolved-placement",
            "no-recipe",
            "build-failed",
            "work-limit"
          ],
          "title": "Reason",
          "type": "string"
        },
        "service_id": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Service Id",
          "type": "string"
        },
        "status": {
          "const": "failed",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "service_id",
        "status",
        "reason",
        "detail"
      ],
      "title": "FailedImageRecord",
      "type": "object"
    },
    "NotEvaluatedImageRecord": {
      "additionalProperties": false,
      "description": "A Fixture placement without a build claim.",
      "properties": {
        "service_id": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Service Id",
          "type": "string"
        },
        "status": {
          "const": "not_evaluated",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "service_id",
        "status"
      ],
      "title": "NotEvaluatedImageRecord",
      "type": "object"
    },
    "PlatformImage": {
      "additionalProperties": false,
      "description": "The image built for one architecture.",
      "properties": {
        "architecture": {
          "enum": [
            "amd64",
            "arm64"
          ],
          "title": "Architecture",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        }
      },
      "required": [
        "architecture",
        "digest"
      ],
      "title": "PlatformImage",
      "type": "object"
    },
    "SourceInputDigest": {
      "additionalProperties": false,
      "description": "Stable exact-byte input correlation embedded in Domain outputs.",
      "properties": {
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "slot": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
          "title": "Slot",
          "type": "string"
        }
      },
      "required": [
        "slot",
        "sha256"
      ],
      "title": "SourceInputDigest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One image-build record per placement of one composition.",
  "properties": {
    "blueprint_id": {
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Blueprint Id",
      "type": "string"
    },
    "combination_id": {
      "pattern": "^C-[0-9]{2}$",
      "title": "Combination Id",
      "type": "string"
    },
    "deployment_schema_id": {
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Deployment Schema Id",
      "type": "string"
    },
    "evidence_basis": {
      "enum": [
        "fixture",
        "implemented"
      ],
      "title": "Evidence Basis",
      "type": "string"
    },
    "image_build_result_id": {
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Image Build Result Id",
      "type": "string"
    },
    "images": {
      "items": {
        "discriminator": {
          "mapping": {
            "built": "#/$defs/BuiltImageRecord",
            "failed": "#/$defs/FailedImageRecord",
            "not_evaluated": "#/$defs/NotEvaluatedImageRecord"
          },
          "propertyName": "status"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/BuiltImageRecord"
          },
          {
            "$ref": "#/$defs/FailedImageRecord"
          },
          {
            "$ref": "#/$defs/NotEvaluatedImageRecord"
          }
        ]
      },
      "minItems": 1,
      "title": "Images",
      "type": "array"
    },
    "profile_id": {
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Profile Id",
      "type": "string"
    },
    "registry": {
      "const": "registry:5000",
      "title": "Registry",
      "type": "string"
    },
    "scenario_id": {
      "pattern": "^S-[0-9]{2}$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "sdi.image-build-result/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_inputs": {
      "items": {
        "$ref": "#/$defs/SourceInputDigest"
      },
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/SourceInputDigest"
            }
          ],
          "properties": {
            "slot": {
              "const": "target_profile"
            }
          }
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/SourceInputDigest"
            }
          ],
          "properties": {
            "slot": {
              "const": "service_repository"
            }
          }
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/SourceInputDigest"
            }
          ],
          "properties": {
            "slot": {
              "const": "composition_blueprint"
            }
          }
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/SourceInputDigest"
            }
          ],
          "properties": {
            "slot": {
              "const": "deployment_schema"
            }
          }
        }
      ],
      "title": "Source Inputs",
      "type": "array"
    },
    "testcase_id": {
      "pattern": "^TC-[0-9]{2}$",
      "title": "Testcase Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "evidence_basis",
    "image_build_result_id",
    "blueprint_id",
    "deployment_schema_id",
    "scenario_id",
    "testcase_id",
    "combination_id",
    "profile_id",
    "source_inputs",
    "registry",
    "images"
  ],
  "title": "ImageBuildResult",
  "type": "object"
}
