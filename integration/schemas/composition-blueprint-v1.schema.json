{
  "$defs": {
    "BlueprintCoverage": {
      "additionalProperties": false,
      "description": "The checked coverage status of one requirement obligation.",
      "properties": {
        "requirement_id": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Requirement Id",
          "type": "string"
        },
        "services": {
          "items": {
            "maxLength": 63,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Services",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/CoverageStatus"
        }
      },
      "required": [
        "requirement_id",
        "status",
        "services"
      ],
      "title": "BlueprintCoverage",
      "type": "object"
    },
    "BlueprintService": {
      "additionalProperties": false,
      "description": "One selected service; capability is an unchecked assigned label.",
      "properties": {
        "capability": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[^/:]+$",
          "title": "Capability",
          "type": "string"
        },
        "depends_on": {
          "items": {
            "maxLength": 63,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "service_id": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Service Id",
          "type": "string"
        }
      },
      "required": [
        "service_id",
        "capability",
        "depends_on"
      ],
      "title": "BlueprintService",
      "type": "object"
    },
    "CoverageStatus": {
      "enum": [
        "supported",
        "missing",
        "uncertain",
        "outside_composition"
      ],
      "type": "string"
    },
    "SourceInputDigest": {
      "additionalProperties": false,
      "description": "Stable exact-byte input correlation embedded in Domain outputs.",
      "properties": {
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "slot": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
          "title": "Slot",
          "type": "string"
        }
      },
      "required": [
        "slot",
        "sha256"
      ],
      "title": "SourceInputDigest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Target-aware logical service composition without validation claims.",
  "properties": {
    "blueprint_id": {
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Blueprint Id",
      "type": "string"
    },
    "combination_id": {
      "pattern": "^C-[0-9]{2}$",
      "title": "Combination Id",
      "type": "string"
    },
    "coverage": {
      "items": {
        "$ref": "#/$defs/BlueprintCoverage"
      },
      "minItems": 1,
      "title": "Coverage",
      "type": "array"
    },
    "evidence_basis": {
      "enum": [
        "fixture",
        "implemented"
      ],
      "title": "Evidence Basis",
      "type": "string"
    },
    "profile_id": {
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Profile Id",
      "type": "string"
    },
    "proposal_id": {
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Proposal Id",
      "type": "string"
    },
    "requirement_ids": {
      "items": {
        "maxLength": 63,
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Requirement Ids",
      "type": "array"
    },
    "scenario_id": {
      "pattern": "^S-[0-9]{2}$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "sdi.composition-blueprint/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "services": {
      "items": {
        "$ref": "#/$defs/BlueprintService"
      },
      "minItems": 1,
      "title": "Services",
      "type": "array"
    },
    "source_inputs": {
      "items": {
        "$ref": "#/$defs/SourceInputDigest"
      },
      "maxItems": 5,
      "minItems": 5,
      "title": "Source Inputs",
      "type": "array"
    },
    "testcase_id": {
      "pattern": "^TC-[0-9]{2}$",
      "title": "Testcase Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "evidence_basis",
    "blueprint_id",
    "proposal_id",
    "scenario_id",
    "testcase_id",
    "combination_id",
    "profile_id",
    "source_inputs",
    "requirement_ids",
    "services",
    "coverage"
  ],
  "title": "CompositionBlueprint",
  "type": "object"
}
