{
  "$defs": {
    "DeployedPlacement": {
      "additionalProperties": false,
      "description": "A placement whose pod ran its pinned image on its host's node and held.",
      "properties": {
        "host": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Host",
          "type": "string"
        },
        "image": {
          "pattern": "^registry:5000/sdi/[a-z][a-z0-9]*(?:-[a-z0-9]+)*@sha256:[0-9a-f]{64}$",
          "title": "Image",
          "type": "string"
        },
        "image_id": {
          "pattern": "^(?:[\\x21-\\x3f\\x41-\\x7e]{1,255}@)?sha256:[0-9a-f]{64}$",
          "title": "Image Id",
          "type": "string"
        },
        "node": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Node",
          "type": "string"
        },
        "phase": {
          "const": "Running",
          "title": "Phase",
          "type": "string"
        },
        "restart_count": {
          "const": 0,
          "title": "Restart Count",
          "type": "integer"
        },
        "service_id": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Service Id",
          "type": "string"
        },
        "status": {
          "const": "deployed",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "service_id",
        "host",
        "status",
        "node",
        "image",
        "image_id",
        "phase",
        "restart_count"
      ],
      "title": "DeployedPlacement",
      "type": "object"
    },
    "FailedPlacement": {
      "additionalProperties": false,
      "description": "A placement whose pod broke the pass rule, with Kubernetes' own reason.",
      "properties": {
        "detail": {
          "pattern": "^[\\x20\\x21\\x23-\\x5b\\x5d-\\x7e]{1,256}$",
          "title": "Detail",
          "type": "string"
        },
        "host": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Host",
          "type": "string"
        },
        "image": {
          "pattern": "^registry:5000/sdi/[a-z][a-z0-9]*(?:-[a-z0-9]+)*@sha256:[0-9a-f]{64}$",
          "title": "Image",
          "type": "string"
        },
        "image_id": {
          "pattern": "^(?:[\\x21-\\x3f\\x41-\\x7e]{1,255}@)?sha256:[0-9a-f]{64}$",
          "title": "Image Id",
          "type": "string"
        },
        "node": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Node",
          "type": "string"
        },
        "phase": {
          "enum": [
            "Pending",
            "Running",
            "Succeeded",
            "Failed",
            "Unknown"
          ],
          "title": "Phase",
          "type": "string"
        },
        "restart_count": {
          "minimum": 0,
          "title": "Restart Count",
          "type": "integer"
        },
        "service_id": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Service Id",
          "type": "string"
        },
        "status": {
          "const": "failed",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "service_id",
        "host",
        "status",
        "detail"
      ],
      "title": "FailedPlacement",
      "type": "object"
    },
    "JsonValue": {},
    "SourceInputDigest": {
      "additionalProperties": false,
      "description": "Stable exact-byte input correlation embedded in Domain outputs.",
      "properties": {
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "slot": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
          "title": "Slot",
          "type": "string"
        }
      },
      "required": [
        "slot",
        "sha256"
      ],
      "title": "SourceInputDigest",
      "type": "object"
    },
    "UndeployedPlacement": {
      "additionalProperties": false,
      "description": "A placement that a pipeline gap kept off the cluster.",
      "properties": {
        "host": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Host",
          "type": "string"
        },
        "reason": {
          "enum": [
            "unresolved-placement",
            "image-not-built",
            "no-image-for-architecture",
            "host-not-in-cluster",
            "blocked"
          ],
          "title": "Reason",
          "type": "string"
        },
        "service_id": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Service Id",
          "type": "string"
        },
        "status": {
          "const": "not_evaluated",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "service_id",
        "status",
        "reason"
      ],
      "title": "UndeployedPlacement",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "How CD deployed one composition to the stand-in cluster.\n\nThe outcome is the attempt's domain outcome: not evaluated when a pipeline\ngap kept every placement off the cluster, failed when any placement broke\nthe pass rule, and succeeded otherwise. The manifest is the Kubernetes\nv1 List CD applied, recorded whenever it reached the cluster.",
  "properties": {
    "blueprint_id": {
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Blueprint Id",
      "type": "string"
    },
    "cluster_kind": {
      "const": "stand_in",
      "title": "Cluster Kind",
      "type": "string"
    },
    "combination_id": {
      "pattern": "^C-[0-9]{2}$",
      "title": "Combination Id",
      "type": "string"
    },
    "deployment_result_id": {
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Deployment Result Id",
      "type": "string"
    },
    "deployment_schema_id": {
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Deployment Schema Id",
      "type": "string"
    },
    "domain_outcome": {
      "enum": [
        "succeeded",
        "failed",
        "not_evaluated"
      ],
      "title": "Domain Outcome",
      "type": "string"
    },
    "evidence_basis": {
      "const": "implemented",
      "title": "Evidence Basis",
      "type": "string"
    },
    "image_build_result_id": {
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Image Build Result Id",
      "type": "string"
    },
    "manifest": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Manifest",
      "type": "object"
    },
    "placements": {
      "items": {
        "discriminator": {
          "mapping": {
            "deployed": "#/$defs/DeployedPlacement",
            "failed": "#/$defs/FailedPlacement",
            "not_evaluated": "#/$defs/UndeployedPlacement"
          },
          "propertyName": "status"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/DeployedPlacement"
          },
          {
            "$ref": "#/$defs/FailedPlacement"
          },
          {
            "$ref": "#/$defs/UndeployedPlacement"
          }
        ]
      },
      "minItems": 1,
      "title": "Placements",
      "type": "array"
    },
    "profile_id": {
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Profile Id",
      "type": "string"
    },
    "scenario_id": {
      "pattern": "^S-[0-9]{2}$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "sdi.deployment-result/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_inputs": {
      "items": {
        "$ref": "#/$defs/SourceInputDigest"
      },
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/SourceInputDigest"
            }
          ],
          "properties": {
            "slot": {
              "const": "target_profile"
            }
          }
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/SourceInputDigest"
            }
          ],
          "properties": {
            "slot": {
              "const": "composition_blueprint"
            }
          }
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/SourceInputDigest"
            }
          ],
          "properties": {
            "slot": {
              "const": "deployment_schema"
            }
          }
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/SourceInputDigest"
            }
          ],
          "properties": {
            "slot": {
              "const": "image_build_result"
            }
          }
        }
      ],
      "title": "Source Inputs",
      "type": "array"
    },
    "testcase_id": {
      "pattern": "^TC-[0-9]{2}$",
      "title": "Testcase Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "evidence_basis",
    "deployment_result_id",
    "blueprint_id",
    "deployment_schema_id",
    "image_build_result_id",
    "scenario_id",
    "testcase_id",
    "combination_id",
    "profile_id",
    "source_inputs",
    "domain_outcome",
    "cluster_kind",
    "placements"
  ],
  "title": "DeploymentResult",
  "type": "object"
}
