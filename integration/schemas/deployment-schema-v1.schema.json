{
  "$defs": {
    "ServicePlacement": {
      "additionalProperties": false,
      "description": "One service placed as a chosen artifact on a profile host.",
      "properties": {
        "artifact_id": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Artifact Id",
          "type": "string"
        },
        "host": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Host",
          "type": "string"
        },
        "service_id": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Service Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "resolved",
            "unresolved"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "service_id",
        "status"
      ],
      "title": "ServicePlacement",
      "type": "object"
    },
    "SourceInputDigest": {
      "additionalProperties": false,
      "description": "Stable exact-byte input correlation embedded in Domain outputs.",
      "properties": {
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "slot": {
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
          "title": "Slot",
          "type": "string"
        }
      },
      "required": [
        "slot",
        "sha256"
      ],
      "title": "SourceInputDigest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Intended placement for every service in one accepted blueprint.",
  "properties": {
    "blueprint_id": {
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Blueprint Id",
      "type": "string"
    },
    "combination_id": {
      "pattern": "^C-[0-9]{2}$",
      "title": "Combination Id",
      "type": "string"
    },
    "deployment_schema_id": {
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Deployment Schema Id",
      "type": "string"
    },
    "evidence_basis": {
      "enum": [
        "fixture",
        "implemented"
      ],
      "title": "Evidence Basis",
      "type": "string"
    },
    "placements": {
      "items": {
        "$ref": "#/$defs/ServicePlacement"
      },
      "minItems": 1,
      "title": "Placements",
      "type": "array"
    },
    "profile_basis": {
      "enum": [
        "declared",
        "placeholder"
      ],
      "title": "Profile Basis",
      "type": "string"
    },
    "profile_id": {
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Profile Id",
      "type": "string"
    },
    "scenario_id": {
      "pattern": "^S-[0-9]{2}$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "sdi.deployment-schema/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_inputs": {
      "items": {
        "$ref": "#/$defs/SourceInputDigest"
      },
      "maxItems": 5,
      "minItems": 5,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/SourceInputDigest"
            }
          ],
          "properties": {
            "slot": {
              "const": "run_request"
            }
          }
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/SourceInputDigest"
            }
          ],
          "properties": {
            "slot": {
              "const": "requirements_specification"
            }
          }
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/SourceInputDigest"
            }
          ],
          "properties": {
            "slot": {
              "const": "target_profile"
            }
          }
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/SourceInputDigest"
            }
          ],
          "properties": {
            "slot": {
              "const": "service_repository"
            }
          }
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/SourceInputDigest"
            }
          ],
          "properties": {
            "slot": {
              "const": "composition_settings"
            }
          }
        }
      ],
      "title": "Source Inputs",
      "type": "array"
    },
    "testcase_id": {
      "pattern": "^TC-[0-9]{2}$",
      "title": "Testcase Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "evidence_basis",
    "deployment_schema_id",
    "blueprint_id",
    "scenario_id",
    "testcase_id",
    "combination_id",
    "profile_id",
    "profile_basis",
    "source_inputs",
    "placements"
  ],
  "title": "DeploymentSchema",
  "type": "object"
}
