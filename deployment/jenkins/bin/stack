#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
repository_root=$(CDPATH= cd -- "$root/../.." && pwd)
config=$root/config/local/controller.env
project_name=${COMPOSE_PROJECT_NAME:-sdi-jenkins}

fail() {
    printf 'stack: %s\n' "$1" >&2
    exit 2
}

usage() {
    printf '%s\n' \
        'usage: stack [--config PATH] [--project-name NAME] validate|start|stop|status|logs|destroy|smoke'
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --config)
            [ "$#" -ge 2 ] || fail '--config requires a path'
            config=$2
            shift 2
            ;;
        --project-name)
            [ "$#" -ge 2 ] || fail '--project-name requires a value'
            project_name=$2
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            break
            ;;
    esac
done

[ "$#" -eq 1 ] || {
    usage >&2
    exit 2
}
action=$1

if [ "$action" = smoke ]; then
    exec "$root/bin/smoke"
fi

compose() {
    docker compose \
        --project-name "$project_name" \
        --project-directory "$root" \
        --env-file "$config" \
        --file "$root/compose.yaml" \
        "$@"
}

case "$action" in
    stop|status|logs|destroy)
        config=/dev/null
        JENKINS_HTTP_PORT=1
        JENKINS_ADMIN_ID=unused
        JENKINS_HANDOFF_ID=unused
        JENKINS_REPOSITORY_URL=https://github.com/unused/unused.git
        JENKINS_ADMIN_PASSWORD_FILE=/dev/null
        JENKINS_HANDOFF_PASSWORD_FILE=/dev/null
        export JENKINS_HTTP_PORT JENKINS_ADMIN_ID JENKINS_HANDOFF_ID
        export JENKINS_REPOSITORY_URL JENKINS_ADMIN_PASSWORD_FILE
        export JENKINS_HANDOFF_PASSWORD_FILE
        case "$action" in
            stop) compose down ;;
            status) compose ps ;;
            logs) compose logs controller ;;
            destroy) compose down --volumes --remove-orphans ;;
        esac
        exit
        ;;
esac

[ -f "$config" ] || fail "configuration file not found: $config"

JENKINS_HTTP_PORT=
JENKINS_ADMIN_ID=
JENKINS_HANDOFF_ID=
JENKINS_REPOSITORY_URL=
JENKINS_ADMIN_PASSWORD_FILE=
JENKINS_HANDOFF_PASSWORD_FILE=

while IFS='=' read -r key value; do
    case "$key" in
        ''|'#'*) ;;
        JENKINS_HTTP_PORT) JENKINS_HTTP_PORT=$value ;;
        JENKINS_ADMIN_ID) JENKINS_ADMIN_ID=$value ;;
        JENKINS_HANDOFF_ID) JENKINS_HANDOFF_ID=$value ;;
        JENKINS_REPOSITORY_URL) JENKINS_REPOSITORY_URL=$value ;;
        JENKINS_ADMIN_PASSWORD_FILE) JENKINS_ADMIN_PASSWORD_FILE=$value ;;
        JENKINS_HANDOFF_PASSWORD_FILE) JENKINS_HANDOFF_PASSWORD_FILE=$value ;;
        *) fail "unknown configuration key: $key" ;;
    esac
done < "$config"

for value in \
    "$JENKINS_HTTP_PORT" \
    "$JENKINS_ADMIN_ID" \
    "$JENKINS_HANDOFF_ID" \
    "$JENKINS_REPOSITORY_URL" \
    "$JENKINS_ADMIN_PASSWORD_FILE" \
    "$JENKINS_HANDOFF_PASSWORD_FILE"
do
    [ -n "$value" ] || fail 'all configuration values are required'
done

case "$JENKINS_HTTP_PORT" in
    *[!0-9]*|'') fail 'JENKINS_HTTP_PORT must be an integer' ;;
esac
[ "$JENKINS_HTTP_PORT" -ge 1 ] && [ "$JENKINS_HTTP_PORT" -le 65535 ] || \
    fail 'JENKINS_HTTP_PORT must be between 1 and 65535'

for user_id in "$JENKINS_ADMIN_ID" "$JENKINS_HANDOFF_ID"; do
    case "$user_id" in
        *[!A-Za-z0-9_.-]*|'') fail 'Jenkins user IDs contain an invalid character' ;;
    esac
done
[ "$JENKINS_ADMIN_ID" != "$JENKINS_HANDOFF_ID" ] || \
    fail 'administrator and handoff user IDs must differ'

case "$JENKINS_REPOSITORY_URL" in
    https://github.com/*/*.git) ;;
    *) fail 'JENKINS_REPOSITORY_URL must be an HTTPS GitHub clone URL' ;;
esac
case "$JENKINS_REPOSITORY_URL" in
    *@*) fail 'JENKINS_REPOSITORY_URL must not contain credentials' ;;
esac

for secret_file in "$JENKINS_ADMIN_PASSWORD_FILE" "$JENKINS_HANDOFF_PASSWORD_FILE"; do
    case "$secret_file" in
        /*) ;;
        *) fail "secret file path must be absolute: $secret_file" ;;
    esac
    [ -f "$secret_file" ] || fail "secret file not found: $secret_file"
    [ -s "$secret_file" ] || fail "secret file is empty: $secret_file"
    resolved_secret=$(realpath -- "$secret_file")
    case "$resolved_secret" in
        "$repository_root"|"$repository_root"/*)
            fail "secret file must be outside the checkout: $secret_file"
            ;;
    esac
    [ "$(stat -c '%u' "$secret_file")" -eq "$(id -u)" ] || \
        fail "secret file must be owned by the current user: $secret_file"
    mode=$(stat -c '%a' "$secret_file")
    [ $((0$mode & 0400)) -ne 0 ] || \
        fail "secret file must be owner-readable: $secret_file"
    [ $((0$mode & 077)) -eq 0 ] || \
        fail "secret file must not be accessible by group or other users: $secret_file"
done

command -v docker >/dev/null 2>&1 || fail 'Docker Engine is required'
[ "$(uname -s)" = Linux ] || fail 'a Linux host is required'
[ "$(uname -m)" = x86_64 ] || fail 'an x86_64 host is required'
platform=$(docker version --format '{{.Server.Os}}/{{.Server.Arch}}') || \
    fail 'Docker Engine is not reachable'
[ "$platform" = linux/amd64 ] || fail "Docker Engine must be linux/amd64, found $platform"

export JENKINS_HTTP_PORT JENKINS_ADMIN_ID JENKINS_HANDOFF_ID
export JENKINS_REPOSITORY_URL JENKINS_ADMIN_PASSWORD_FILE
export JENKINS_HANDOFF_PASSWORD_FILE

validate() {
    expected_image='docker.io/jenkins/jenkins:2.568.3-jdk21@sha256:68964c38dbb70c0bf6adff480d6dda2e1191d2d07e076c9fd2996345303eb999'
    IFS= read -r first_line < "$root/controller/Dockerfile"
    [ "$first_line" = "FROM $expected_image" ] || \
        fail 'controller base image does not match the reviewed immutable pin'

    plugin_count=0
    plugin_lines='
'
    while IFS= read -r plugin; do
        [ -n "$plugin" ] || continue
        case "$plugin" in
            [a-z0-9-]*:*) ;;
            *) fail "invalid plugin lock entry: $plugin" ;;
        esac
        case "$plugin_lines" in
            *"
$plugin
"*) fail "duplicate plugin lock entry: $plugin" ;;
        esac
        plugin_lines="$plugin_lines$plugin
"
        plugin_count=$((plugin_count + 1))
    done < "$root/controller/plugins.txt"
    [ "$plugin_count" -eq 47 ] || \
        fail "plugin lock must contain 47 entries, found $plugin_count"
    set -- $(sha256sum "$root/controller/plugins.txt")
    [ "$1" = e2e20a6cf937d948df5046aba92fa3185ccfcbb74fd7ddf3ac10d6a4798a1977 ] || \
        fail 'plugin lock does not match the reviewed versions'

    docker build --check --file "$root/controller/Dockerfile" "$root" >/dev/null
    compose config --quiet
}

case "$action" in
    validate)
        validate
        ;;
    start)
        validate
        docker build \
            --platform linux/amd64 \
            --tag sdi-jenkins-controller:2.568.3 \
            --file "$root/controller/Dockerfile" \
            "$root"
        compose up --no-build --detach --wait --wait-timeout 240 controller
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
